{
  "name": "warrior-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive 3D globe mapping the history and lineage of world martial arts, built on Esri's ArcGIS Maps SDK.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run graph && next build",
    "start": "next start",
    "lint": "next lint",
    "graph": "tsx scripts/build-graph.ts",
    "covers": "tsx --env-file-if-exists=.env.local scripts/fetch-covers.ts"
  },
  "dependencies": {
    "@arcgis/core": "^4.31.6",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.462.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/topojson-client": "^3.1.5",
    "playwright": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
